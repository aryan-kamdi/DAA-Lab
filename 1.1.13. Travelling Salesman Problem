#include <stdio.h>
#include <stdlib.h>

#define INF 1e9

int n;
int matrix[20][20];
int dp[1 << 20][20];


int min(int a, int b) {
    return (a < b) ? a : b;
}

int tsp(int mask, int u) {

    if (mask == (1 << n) - 1) {

        return (matrix[u][0] != -1) ? matrix[u][0] : INF;
    }
    

    if (dp[mask][u] != -1) {
        return dp[mask][u];
    }
    
    int min_cost = INF;
    

    for (int v = 0; v < n; v++) {

        if (!(mask & (1 << v)) && matrix[u][v] != -1) {
            int new_cost = matrix[u][v] + tsp(mask | (1 << v), v);
            min_cost = min(min_cost, new_cost);
        }
    }
    
    return dp[mask][u] = min_cost;
}

int main() {

    if (scanf("%d", &n) != 1) return 0;
    

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (scanf("%d", &matrix[i][j]) != 1) return 0;
        }
    }
    

    for (int i = 0; i < (1 << n); i++) {
        for (int j = 0; j < n; j++) {
            dp[i][j] = -1;
        }
    }
    

    int result = tsp(1, 0);
    

    if (result >= INF) {
        printf("-1\n");
    } else {
        printf("%d\n", result);
    }
    
    return 0;
}


